{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "components/product/**/*.tsx",
    "lib/model.ts",
    "lib/validation.ts",
    "lib/csv.ts",
    "lib/reports.ts",
    "server/**/*.ts",
    "db/schema.ts"
  ]
}